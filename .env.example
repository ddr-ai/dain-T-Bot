# ============================================================
# Gemini Autopilot Bot - configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it is already in .gitignore).
# ============================================================

# --- Gemini credentials (leave blank to start in paper mode) ---
# Key must have ONLY "Account Balances" + "Orders" permissions.
# WITHDRAWALS MUST BE DISABLED on the key.
GEMINI_API_KEY=
GEMINI_API_SECRET=

# Private API base URL. Paper mode uses Gemini's sandbox:
GEMINI_BASE_URL=https://api.sandbox.gemini.com
# For LIVE trading switch to: https://api.gemini.com

# Public market data always comes from the live public API:
GEMINI_PUBLIC_BASE_URL=https://api.gemini.com

# --- Symbols (Gemini spot symbols) ---
TRADING_SYMBOLS=btcusd,ethusd,solusd

# --- Risk management ---
RISK_PER_TRADE_PCT=1.5
MAX_RISK_PER_TRADE_PCT=3.0
DAILY_LOSS_WARNING_PCT=3.0
DAILY_LOSS_LIMIT_PCT=5.0
MAX_CONCURRENT_POSITIONS=3
MAX_TRADES_PER_SYMBOL_PER_DAY=5
MAX_SETUPS_PER_SYMBOL_PER_4H=1
COOLDOWN_MINUTES=45

# Risk:reward slider (sets take-profit distance ONLY)
DEFAULT_RISK_REWARD=1.5
RISK_REWARD_MIN=0.5
RISK_REWARD_MAX=3.0

# Stops and exits
ATR_STOP_MULTIPLIER=1.5
MIN_STOP_PCT=1.5
MAX_BUYING_POWER_PCT=50.0
CORRELATION_CAP=0.85
MIN_VOLUME_MULTIPLIER=1.5

# Order chunking: entries larger than this are sliced into 2-3 child orders
ORDER_CHUNK_THRESHOLD_USD=1000

# Auto trade management
TRAILING_STOP_ENABLED=true
BREAKEVEN_ENABLED=true
PARTIAL_PROFIT_ENABLED=false
TIME_EXIT_HOURS=4

# Paper trading (true = sandbox paper mode, false = LIVE with real funds)
PAPER_TRADING=true
PAPER_STARTING_CASH=100

# Fees (basis points). Set to your actual Gemini fee tier.
# Base tier example: maker 0.20% = 20 bps, taker 0.40% = 40 bps.
MAKER_FEE_BPS=20
TAKER_FEE_BPS=40
SLIPPAGE_BPS=2

# Strategy cadence (seconds)
SCAN_INTERVAL_SEC=60
MANAGE_INTERVAL_SEC=15
# Pause new entries if no price tick for this many ms:
STALE_PRICE_MS=60000

# Market quality guards
MIN_DEPTH_USD=5000
MAX_SPREAD_BPS=10
MIN_AVAILABLE_USD=10
RR_ABORT_MIN=1.2

# --- Server ---
PORT=3000
# Optional shared secret clients must send as "Authorization: Bearer <token>".
# Strongly recommended if the backend is reachable from the internet.
API_AUTH_TOKEN=

# 32-byte random base64 string used to encrypt credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
